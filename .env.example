# Copie para .env.local (já ignorado pelo git) e preencha com os dados do projeto Supabase
# (Project Settings → API Keys).
#
# Use a chave "publishable" (sb_publishable_...). Ela é pública por definição — vai embutida no app, e a
# segurança dos dados vem do RLS. A chave antiga "anon" ainda funciona, mas o Supabase vai descontinuá-la
# até o fim de 2026; o nome da variável abaixo é histórico e vale para as duas.
# NUNCA coloque aqui a chave "secret" (sb_secret_...) nem a "service_role": elas ignoram o RLS.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Google Calendar (opcional). Cliente OAuth do tipo "App para computador" no Google Cloud Console
# (ver README → "Google Calendar"). Sem essas variáveis o botão de conectar avisa que está indisponível.
# Nesse tipo de cliente o "secret" não é confidencial: ele vai embutido no app e o fluxo é protegido por PKCE.
VITE_GOOGLE_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_SECRET=GOCSPX-...
