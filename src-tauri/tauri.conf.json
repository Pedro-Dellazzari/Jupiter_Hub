{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jupiter Hub",
  "version": "0.1.0",
  "identifier": "com.pedro.hubprodutividade",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Jupiter Hub",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzNEU3QkRCMUEwMDQ5REMKUldUY1NRQWEyM3RPNDh0N1hYcGhwekwvVmFJYzlOZ3Ura1cySXdUOEg2a3lrV1hrNDMxYzJrTisK",
      "endpoints": [
        "https://github.com/Pedro-Dellazzari/Jupiter_Hub/releases/latest/download/latest.json"
      ]
    }
  }
}
